{
  "name": "zinfer",
  "version": "0.1.7",
  "description": "Extract input/output types from Zod schemas",
  "keywords": [
    "schema",
    "type-extraction",
    "typescript",
    "zod"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toiroakr/zinfer.git"
  },
  "bin": {
    "zinfer": "./bin/zinfer"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "generate:type-tests": "node ./dist/cli.js 'tests/fixtures/*.ts' --outDir tests/__file_snapshots__ --outPattern '[name].ts' --generate-tests --suffix Schema"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "glob": "^13.0.0",
    "jiti": "^2.6.1",
    "pathe": "^2.0.3",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/node": "25.3.3",
    "@typescript/native-preview": "7.0.0-dev.20260302.1",
    "knip": "5.85.0",
    "lefthook": "2.1.2",
    "oxfmt": "0.36.0",
    "oxlint": "1.51.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "zod": ">=3.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}
