{
  "name": "zinfer-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "node --test .github/scripts/test-lockfile-runtime-diff.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:tsc": "pnpm -r typecheck:tsc",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "knip": "knip",
    "changeset": "changeset",
    "release": "pnpm -r build && changeset publish",
    "test:api": "pnpm --filter @zinfer-monorepo/core test:api"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "packageManager": "pnpm@12.21.0"
}
