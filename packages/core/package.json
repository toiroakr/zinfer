{
  "name": "@zinfer-monorepo/core",
  "version": "0.0.0",
  "private": true,
  "description": "Schema-library-agnostic core shared by zinfer and vinfer (internal, unpublished)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.api-coverage.json",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test:api": "vitest run --config api-coverage.config.ts"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "pathe": "^2.0.3",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "knip": "6.34.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
