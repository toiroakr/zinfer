{
  "name": "@zinfer-monorepo/core",
  "version": "0.0.0",
  "private": true,
  "description": "Schema-library-agnostic core shared by zinfer and vinfer (internal, unpublished)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit && node node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.api-coverage.json",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:api": "vitest run --config api-coverage.config.ts"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "pathe": "^2.0.3",
    "typescript-native": "catalog:"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "ts-morph": "28.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
