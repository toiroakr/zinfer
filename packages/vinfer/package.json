{
  "name": "vinfer",
  "version": "0.4.1",
  "description": "Extract input/output types from Valibot schemas",
  "keywords": [
    "schema",
    "type-extraction",
    "typescript",
    "valibot",
    "valibot-to-ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toiroakr/zinfer.git",
    "directory": "packages/vinfer"
  },
  "bin": {
    "vinfer": "./bin/vinfer"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate:type-tests": "node ./dist/cli.js 'tests/fixtures/*.ts' --outDir tests/__file_snapshots__ --outPattern '[name].ts' --generate-tests --suffix Schema"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "jiti": "^2.7.0",
    "pathe": "^2.0.3",
    "typescript-native": "catalog:"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "@zinfer-monorepo/core": "workspace:*",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "ts-morph": "28.0.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "valibot": ">=1.1.0"
  }
}
