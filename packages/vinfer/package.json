{
  "name": "vinfer",
  "version": "0.3.3",
  "description": "Extract input/output types from Valibot schemas",
  "keywords": [
    "schema",
    "type-extraction",
    "typescript",
    "valibot",
    "valibot-to-ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toiroakr/zinfer.git",
    "directory": "packages/vinfer"
  },
  "bin": {
    "vinfer": "./bin/vinfer"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && dts-bundle-generator --config dts-bundle-generator.config.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "generate:type-tests": "node ./dist/cli.js 'tests/fixtures/*.ts' --outDir tests/__file_snapshots__ --outPattern '[name].ts' --generate-tests --suffix Schema"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "jiti": "^2.7.0",
    "pathe": "^2.0.3",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@zinfer-monorepo/core": "workspace:*",
    "dts-bundle-generator": "^9.5.1",
    "knip": "6.32.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsup": "^8.0.0",
    "typescript": "7.0.2",
    "valibot": "1.4.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "valibot": ">=1.1.0"
  }
}
