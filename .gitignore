# Test fixtures deliberately containing a real (checked-in) node_modules
# package to exercise dependency-package module resolution - not a real
# installed dependency, so it isn't covered by the `node_modules/` ignore
# above.
!packages/*/tests/fixtures/**/node_modules/
!packages/*/tests/fixtures/**/node_modules/**
